        Color3.fromRGB(226, 226, 236),
        Workspace,
        Enum.Material.SmoothPlastic
    )
    spawnPad.Shape = Enum.PartType.Cylinder
    spawnPad.Name = "SpawnPad"

    local spawnLocation = Instance.new("SpawnLocation")
