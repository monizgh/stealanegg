    cash.Name = "CashLabel"
    cash.AnchorPoint = Vector2.new(0, 1)
    cash.TextStrokeTransparency = 1
    cash.TextStrokeColor3 = PALETTE.ink

    local function makeSlot(offsetX, number, iconBuilder)
        local slot = Instance.new("Frame")
