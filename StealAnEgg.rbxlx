	ParticleScale.Parent = Particle

	local RandomScale =
		math.random(80, 125) / 100

	local RotationChange =
		math.random(-150, 150)

	local ScaleTween = TweenService:Create(
		ParticleScale,
		TweenInfo.new(
			0.16,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Scale = RandomScale
		}
	)

	local MoveTween = TweenService:Create(
		Particle,
		TweenInfo.new(
			BURST_TIME,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),
		{
			Position = UDim2.new(
				0.5,
				EndX,
				0.5,
				EndY
			),

			Rotation =
				Particle.Rotation
				+ RotationChange
		}
	)

	ScaleTween:Play()
	MoveTween:Play()

	task.delay(BURST_TIME * 0.32, function()
		if not Particle.Parent then
			return
		end

		local FadeTween = TweenService:Create(
			Particle,
			TweenInfo.new(
				BURST_TIME * 0.68,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			),
			{
				ImageTransparency = 1
			}
		)

		local ShrinkTween = TweenService:Create(
			ParticleScale,
			TweenInfo.new(
				BURST_TIME * 0.68,
				Enum.EasingStyle.Quart,
				Enum.EasingDirection.In
			),
			{
				Scale = 0.15
			}
		)

		FadeTween:Play()
		ShrinkTween:Play()
	end)

	task.delay(BURST_TIME + 0.1, function()
		if Particle then
			Particle:Destroy()
		end
	end)
end

local function Burst()
	for Index = 1, BURST_COUNT do
		CreateParticle(Index)
	end
end

local function ClickBounce()
	if Clicking then
		return
	end

	Clicking = true

	PlaySound(ClickSound)
	Burst()

	TargetScale = CLICK_SCALE

	task.delay(0.065, function()
		if Destroyed then
			return
		end

		if Hovering then
			TargetScale = 1.09
		else
			TargetScale = 1.045
		end
	end)

	task.delay(0.15, function()
		if Destroyed then
			return
		end

		if Hovering then
			TargetScale = 1.04
		else
			TargetScale = 0.985
		end
	end)

	task.delay(0.24, function()
		if Destroyed then
			return
		end

		if Hovering then
			TargetScale = HOVER_SCALE
		else
			TargetScale = 1
		end
	end)

	task.delay(0.34, function()
		Clicking = false
	end)
end

Button.MouseEnter:Connect(function()
	Hovering = true

	PlaySound(HoverSound)

	if not Clicking then
		TargetScale = HOVER_SCALE
	end
end)

Button.MouseLeave:Connect(function()
	Hovering = false

	TargetX = 0
	TargetY = 0

	if not Clicking then
		TargetScale = 1
	end
end)

Button.Activated:Connect(function()
	ClickBounce()
end)

Button.AncestryChanged:Connect(function()
	if not Button:IsDescendantOf(game) then
		Destroyed = true
	end
end)

RunService.RenderStepped:Connect(function(DeltaTime)
	if Destroyed then
		return
	end

	if not Button.Parent then
		return
	end

	if Hovering then
		local MousePosition = UserInputService:GetMouseLocation()

		local AbsolutePosition = Button.AbsolutePosition
		local AbsoluteSize = Button.AbsoluteSize

		local CenterX =
			AbsolutePosition.X
			+ (AbsoluteSize.X / 2)

		local CenterY =
			AbsolutePosition.Y
			+ (AbsoluteSize.Y / 2)

		local DifferenceX =
			MousePosition.X
		- CenterX

		local DifferenceY =
			MousePosition.Y
		- CenterY

		local NormalX = math.clamp(
			DifferenceX / math.max(
				AbsoluteSize.X / 2,
				1
			),
			-1,
			1
		)

		local NormalY = math.clamp(
			DifferenceY / math.max(
				AbsoluteSize.Y / 2,
				1
			),
			-1,
			1
		)

		TargetX =
			NormalX
			* MAGNET_STRENGTH

		TargetY =
			NormalY
			* MAGNET_STRENGTH
	end

	local PositionAlpha =
		SmoothAlpha(
			MAGNET_SMOOTHNESS,
			DeltaTime
		)

	CurrentX =
		CurrentX
		+ ((TargetX - CurrentX)
			* PositionAlpha)

	CurrentY =
		CurrentY
		+ ((TargetY - CurrentY)
			* PositionAlpha)

	Button.Position = UDim2.new(
		OriginalPosition.X.Scale,

		OriginalPosition.X.Offset
			+ CurrentX,

		OriginalPosition.Y.Scale,

		OriginalPosition.Y.Offset
			+ CurrentY
	)

	local ScaleAlpha =
		SmoothAlpha(
			SCALE_SMOOTHNESS,
			DeltaTime
		)

	CurrentScale =
		CurrentScale
		+ ((TargetScale - CurrentScale)
			* ScaleAlpha)

	Scale.Scale = CurrentScale
end)

task.spawn(function()
	while Button.Parent and not Destroyed do
		task.wait(
			math.random(60, 100) / 10
		)

		if
			not Hovering
			and not Clicking
			and not Destroyed
		then
			PlaySound(IdleSound)

			TargetScale = 1.018

			task.wait(0.13)

			if
				not Hovering
				and not Clicking
				and not Destroyed
			then
				TargetScale = 0.995
			end

			task.wait(0.12)

			if
				not Hovering
				and not Clicking
				and not Destroyed
			then
				TargetScale = 1
			end
		end
	end
end)]]></ProtectedString>
