			math.floor(MIN_FADE_IN_TIME * 100),
			math.floor(MAX_FADE_IN_TIME * 100)
		) / 100

	local TargetTransparency =
		math.random(4, 14) / 100

	task.delay(FadeDelay, function()
		if Destroyed then
			return
		end

		if not Bubble.Parent then
			return
		end

		Tween(
			Bubble,
			FadeInDuration,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out,
			{
				ImageTransparency =
					TargetTransparency
			}
		)

		Tween(
			BubbleScale,
			FadeInDuration * 1.08,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out,
			{
				Scale = FinalScale
			}
		)
	end)

	Tween(
		Bubble,
		Duration,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out,
		{
			Position = UDim2.new(
				0.5,
				StartX + Drift,
				1,
				-RiseHeight
			),

			Rotation =
				Bubble.Rotation
				+ math.random(-35, 35)
		}
	)

	task.delay(Duration * 0.32, function()
		if not Bubble.Parent then
			return
		end

		Tween(
			BubbleScale,
			Duration * 0.38,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			{
				Scale =
					FinalScale
					* math.random(104, 112)
					/ 100
			}
		)
	end)

	local FadeOutStart =
		Duration
		* math.random(62, 72)
		/ 100

	task.delay(FadeOutStart, function()
		if not Bubble.Parent then
			return
		end

		local FadeOutTime =
			math.max(
				Duration - FadeOutStart,
				0.25
			)

		Tween(
			Bubble,
			FadeOutTime,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.In,
			{
				ImageTransparency = 1
			}
		)

		Tween(
			BubbleScale,
			FadeOutTime,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In,
			{
				Scale =
					FinalScale
					* math.random(35, 55)
					/ 100
			}
		)
	end)

	task.delay(Duration + 0.08, function()
		if Bubble then
			Bubble:Destroy()
		end
	end)
end

local function BubbleRise(Count)
	for Index = 1, Count do

		local SpawnDelay =
			(Index - 1)
			* math.random(22, 55)
			/ 1000

		SpawnDelay +=
			math.random(0, 45)
			/ 1000

		task.delay(SpawnDelay, function()
			CreateBubble()
		end)
	end
end

local function HoverEnter()
	if Destroyed then
		return
	end

	Hovering = true

	PlaySound(HoverSound)

	if Clicking then
		return
	end

	Tween(
		Scale,
		0.36,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Scale = HOVER_SCALE
		}
	)

	Tween(
		Button,
		0.36,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Position = GetHoverPosition(),
			Rotation = OriginalRotation - 0.4
		}
	)

	BubbleRise(3)
end

local function HoverLeave()
	if Destroyed then
		return
	end

	Hovering = false

	if Clicking then
		return
	end

	Tween(
		Scale,
		0.4,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Scale = 1
		}
	)

	Tween(
		Button,
		0.4,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Position = OriginalPosition,
			Rotation = OriginalRotation
		}
	)
end

local function ClickAnimation()
	if Clicking then
		return
	end

	Clicking = true

	PlaySound(ClickSound)

	BubbleRise(BUBBLE_COUNT)

	Tween(
		Scale,
		0.11,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out,
		{
			Scale = CLICK_SCALE
		}
	)

	Tween(
		Button,
		0.11,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out,
		{
			Position = UDim2.new(
				OriginalPosition.X.Scale,
				OriginalPosition.X.Offset,
				OriginalPosition.Y.Scale,
				OriginalPosition.Y.Offset + 2
			),

			Rotation = OriginalRotation + 0.5
		}
	)

	task.delay(0.1, function()
		if Destroyed then
			return
		end

		Tween(
			Scale,
			0.28,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out,
			{
				Scale =
					Hovering
					and 1.052
					or 1.016
			}
		)

		Tween(
			Button,
			0.28,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out,
			{
				Position =
					Hovering
					and GetHoverPosition()
					or OriginalPosition,

				Rotation =
					Hovering
					and OriginalRotation - 0.3
					or OriginalRotation
			}
		)
	end)

	task.delay(0.34, function()
		if Destroyed then
			return
		end

		Tween(
			Scale,
			0.32,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out,
			{
				Scale =
					Hovering
					and HOVER_SCALE
					or 1
			}
		)

		Tween(
			Button,
			0.32,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out,
			{
				Position =
					Hovering
					and GetHoverPosition()
					or OriginalPosition,

				Rotation =
					Hovering
					and OriginalRotation - 0.4
					or OriginalRotation
			}
		)
	end)

	task.delay(0.58, function()
		Clicking = false
	end)
end

Button.MouseEnter:Connect(HoverEnter)
Button.MouseLeave:Connect(HoverLeave)
Button.Activated:Connect(ClickAnimation)

Button.AncestryChanged:Connect(function()
	if not Button:IsDescendantOf(game) then
		Destroyed = true
	end
end)

task.spawn(function()
	while Button.Parent and not Destroyed do

		task.wait(
			math.random(65, 100) / 10
		)

		if
			not Hovering
			and not Clicking
			and not Destroyed
		then

			PlaySound(IdleSound)

			Tween(
				Scale,
				0.75,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut,
				{
					Scale = 1.01
				}
			)

			Tween(
				Button,
				0.75,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut,
				{
					Position = UDim2.new(
						OriginalPosition.X.Scale,
						OriginalPosition.X.Offset,
						OriginalPosition.Y.Scale,
						OriginalPosition.Y.Offset - 1
