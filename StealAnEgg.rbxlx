local BIKES = {
    { name = "Starter Bike", price = 0, multiplier = 1, color = Color3.fromRGB(206, 74, 66), wheelSize = 3.2 },
    { name = "Cruiser", price = 1500, multiplier = 1.2, color = Color3.fromRGB(80, 170, 255), wheelSize = 3.5 },
