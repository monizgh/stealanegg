									<ProtectedString name="Source"><![CDATA[-- made by lft_productions

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Button = script.Parent

local HOVER_SOUND_ID = "rbxassetid://136108770017536"
local CLICK_SOUND_ID = "rbxassetid://122835655736085"
local IDLE_SOUND_ID = "rbxassetid://136108770017536"

local BURST_IMAGE_ID = "rbxassetid://96160646700358"

local HOVER_SCALE = 1.07
local CLICK_SCALE = 0.875

local MAGNET_STRENGTH = 8
local MAGNET_SMOOTHNESS = 13

local TILT_STRENGTH = 3
local TILT_SMOOTHNESS = 11

local SCALE_SMOOTHNESS = 17

local BURST_COUNT = 14
local BURST_MIN_DISTANCE = 42
local BURST_MAX_DISTANCE = 88
local BURST_TIME = 0.48

local Hovering = false
local Clicking = false
local Destroyed = false

local OriginalPosition = Button.Position
local OriginalRotation = Button.Rotation

Button.ClipsDescendants = false

local Scale = Button:FindFirstChildOfClass("UIScale")

if not Scale then
	Scale = Instance.new("UIScale")
	Scale.Scale = 1
	Scale.Parent = Button
end

local function SmoothAlpha(Speed, DeltaTime)
	return 1 - math.exp(-Speed * DeltaTime)
end

local function CreateSound(Name, ID, Volume, PlaybackSpeed)
	local Sound = Instance.new("Sound")
	Sound.Name = Name
	Sound.SoundId = ID
	Sound.Volume = Volume
	Sound.PlaybackSpeed = PlaybackSpeed or 1
	Sound.Parent = Button

	return Sound
end

local HoverSound = CreateSound(
	"HoverSound",
	HOVER_SOUND_ID,
	0.32,
	1.04
)

local ClickSound = CreateSound(
	"ClickSound",
	CLICK_SOUND_ID,
	0.6,
	1
)

local IdleSound = CreateSound(
	"IdleSound",
	IDLE_SOUND_ID,
	0.13,
	1.08
)

local function PlaySound(Sound)
	if not Sound then
		return
	end

	if Sound.SoundId == "" then
		return
	end

	if Sound.SoundId == "rbxassetid://0" then
		return
	end

	Sound.TimePosition = 0
	Sound:Play()
end

local BurstContainer = Instance.new("Frame")
BurstContainer.Name = "BurstContainer"
BurstContainer.AnchorPoint = Vector2.new(0.5, 0.5)
BurstContainer.Position = UDim2.fromScale(0.5, 0.5)
BurstContainer.Size = UDim2.fromScale(1, 1)
BurstContainer.BackgroundTransparency = 1
BurstContainer.BorderSizePixel = 0
BurstContainer.ClipsDescendants = false
BurstContainer.ZIndex = Button.ZIndex + 20
BurstContainer.Parent = Button

local TargetX = 0
local TargetY = 0

local CurrentX = 0
local CurrentY = 0

local TargetRotation = OriginalRotation
local CurrentRotation = OriginalRotation

local TargetScale = 1
local CurrentScale = Scale.Scale

local ClickOffsetX = 0
local ClickOffsetY = 0

local IdleOffset = 0
local IdleRotation = 0

local ClickSequence = 0

local function SetScaleForState()
	if Clicking then
		return
	end

	if Hovering then
		TargetScale = HOVER_SCALE
	else
		TargetScale = 1
	end
end

local function CreateParticle(Index)
	if Destroyed then
		return
	end

	local Angle =
		((math.pi * 2) / BURST_COUNT) * Index
		+ math.rad(math.random(-12, 12))

	local Distance = math.random(
		BURST_MIN_DISTANCE,
		BURST_MAX_DISTANCE
	)

	local EndX = math.cos(Angle) * Distance
	local EndY = math.sin(Angle) * Distance

	local StartDistance = math.random(0, 7)

	local StartX = math.cos(Angle) * StartDistance
	local StartY = math.sin(Angle) * StartDistance

	local Particle = Instance.new("ImageLabel")

	Particle.Name = "BurstParticle"
	Particle.AnchorPoint = Vector2.new(0.5, 0.5)

	Particle.Position = UDim2.new(
		0.5,
		StartX,
		0.5,
		StartY
	)

	local ParticleSize = math.random(10, 22)

	Particle.Size = UDim2.fromOffset(
		ParticleSize,
		ParticleSize
	)

	Particle.BackgroundTransparency = 1
	Particle.BorderSizePixel = 0

	Particle.Image = BURST_IMAGE_ID
	Particle.ImageTransparency = 0.05

	Particle.Rotation = math.random(-180, 180)

	Particle.ZIndex = Button.ZIndex + 25
	Particle.Parent = BurstContainer

	local ParticleScale = Instance.new("UIScale")
	ParticleScale.Scale = 0
	ParticleScale.Parent = Particle

	local RandomScale = math.random(75, 125) / 100
	local RotationChange = math.random(-180, 180)

	local PopTween = TweenService:Create(
		ParticleScale,
		TweenInfo.new(
			0.18,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Scale = RandomScale
		}
	)

	local MoveTween = TweenService:Create(
		Particle,
		TweenInfo.new(
			BURST_TIME,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Position = UDim2.new(
				0.5,
				EndX,
				0.5,
				EndY
			),

			Rotation =
				Particle.Rotation
				+ RotationChange
		}
	)

	PopTween:Play()
	MoveTween:Play()

	task.delay(BURST_TIME * 0.36, function()
		if Destroyed then
			return
		end

		if not Particle.Parent then
			return
		end

		local FadeTween = TweenService:Create(
			Particle,
			TweenInfo.new(
				BURST_TIME * 0.64,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			),
			{
				ImageTransparency = 1
			}
		)

		local ShrinkTween = TweenService:Create(
			ParticleScale,
			TweenInfo.new(
				BURST_TIME * 0.64,
				Enum.EasingStyle.Quart,
				Enum.EasingDirection.In
			),
			{
				Scale = 0.1
			}
		)

		FadeTween:Play()
		ShrinkTween:Play()
	end)

	task.delay(BURST_TIME + 0.12, function()
		if Particle then
			Particle:Destroy()
		end
	end)
end

local function Burst()
	for Index = 1, BURST_COUNT do
		task.delay((Index - 1) * 0.006, function()
			CreateParticle(Index)
		end)
	end
end

local function MicroBurst()
	for Index = 1, 5 do
		task.delay((Index - 1) * 0.008, function()
			if Destroyed then
				return
			end

			local Angle =
				math.rad(
					math.random(0, 359)
				)

			local Distance =
				math.random(24, 42)

			local Particle = Instance.new("ImageLabel")

			Particle.Name = "MicroBurst"

			Particle.AnchorPoint =
				Vector2.new(0.5, 0.5)

			Particle.Position =
				UDim2.fromScale(
					0.5,
					0.5
				)

			local Size =
				math.random(6, 12)

			Particle.Size =
				UDim2.fromOffset(
					Size,
					Size
				)

			Particle.BackgroundTransparency = 1
			Particle.BorderSizePixel = 0

			Particle.Image = BURST_IMAGE_ID
			Particle.ImageTransparency = 0.15

			Particle.Rotation =
				math.random(-180, 180)

			Particle.ZIndex =
				Button.ZIndex + 24

			Particle.Parent =
				BurstContainer

			local ParticleScale =
				Instance.new("UIScale")

			ParticleScale.Scale = 0

			ParticleScale.Parent =
				Particle

			local EndX =
				math.cos(Angle)
				* Distance

			local EndY =
				math.sin(Angle)
				* Distance

			TweenService:Create(
				ParticleScale,
				TweenInfo.new(
					0.14,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				),
				{
					Scale = 0.7
				}
			):Play()

			TweenService:Create(
				Particle,
				TweenInfo.new(
					0.33,
					Enum.EasingStyle.Quart,
					Enum.EasingDirection.Out
				),
				{
					Position =
						UDim2.new(
							0.5,
							EndX,
							0.5,
							EndY
						),

					ImageTransparency = 1,

					Rotation =
						Particle.Rotation
						+ math.random(
							-90,
							90
						)
				}
			):Play()

			task.delay(0.36, function()
				if Particle then
					Particle:Destroy()
				end
			end)
		end)
	end
end

local function ClickBounce()
	if Clicking then
		return
	end

	Clicking = true

	ClickSequence += 1

	local Sequence = ClickSequence

	PlaySound(ClickSound)

	Burst()

	ClickOffsetY = 2
	ClickOffsetX = math.random(-1, 1)

	TargetScale = CLICK_SCALE

	TargetRotation =
		OriginalRotation
		+ math.random(-2, 2)

	task.delay(0.055, function()
		if Destroyed then
			return
		end

		if Sequence ~= ClickSequence then
			return
		end

		ClickOffsetY = -1

		if Hovering then
			TargetScale = 1.115
		else
			TargetScale = 1.075
		end

		TargetRotation =
			OriginalRotation
			+ math.random(-3, 3)
	end)

	task.delay(0.125, function()
		if Destroyed then
			return
		end

		if Sequence ~= ClickSequence then
			return
		end

		MicroBurst()

		ClickOffsetY = 0
		ClickOffsetX = 0

		if Hovering then
			TargetScale = 1.035
		else
			TargetScale = 0.985
		end

		TargetRotation =
			OriginalRotation
			+ math.random(-1, 1)
	end)

	task.delay(0.205, function()
		if Destroyed then
			return
		end

		if Sequence ~= ClickSequence then
			return
		end

		if Hovering then
			TargetScale = 1.082
		else
			TargetScale = 1.018
		end

		TargetRotation = OriginalRotation
	end)

	task.delay(0.29, function()
		if Destroyed then
			return
		end

		if Sequence ~= ClickSequence then
			return
		end

		if Hovering then
			TargetScale = HOVER_SCALE
		else
			TargetScale = 1
		end

		TargetRotation = OriginalRotation
	end)

	task.delay(0.38, function()
		if Destroyed then
			return
		end

		if Sequence ~= ClickSequence then
			return
		end

		Clicking = false

		ClickOffsetX = 0
		ClickOffsetY = 0

		SetScaleForState()
	end)
end

Button.MouseEnter:Connect(function()
	Hovering = true

	PlaySound(HoverSound)

	if not Clicking then
		TargetScale = HOVER_SCALE
	end
end)

Button.MouseLeave:Connect(function()
	Hovering = false

	TargetX = 0
	TargetY = 0

	IdleOffset = 0
	IdleRotation = 0

	if not Clicking then
		TargetScale = 1
		TargetRotation = OriginalRotation
	end
end)

Button.Activated:Connect(function()
	ClickBounce()
end)

Button.AncestryChanged:Connect(function()
	if not Button:IsDescendantOf(game) then
		Destroyed = true
	end
end)

RunService.RenderStepped:Connect(function(DeltaTime)
	if Destroyed then
		return
	end

	if not Button.Parent then
		return
	end

	if Hovering then
		local MousePosition =
			UserInputService:GetMouseLocation()

		local AbsolutePosition =
			Button.AbsolutePosition

		local AbsoluteSize =
			Button.AbsoluteSize

		local CenterX =
			AbsolutePosition.X
			+ AbsoluteSize.X / 2

		local CenterY =
			AbsolutePosition.Y
			+ AbsoluteSize.Y / 2

		local DifferenceX =
			MousePosition.X
		- CenterX

		local DifferenceY =
			MousePosition.Y
		- CenterY

		local NormalX =
			math.clamp(
				DifferenceX
				/ math.max(
					AbsoluteSize.X / 2,
					1
				),
				-1,
				1
			)

		local NormalY =
			math.clamp(
				DifferenceY
				/ math.max(
					AbsoluteSize.Y / 2,
					1
				),
				-1,
				1
			)

		TargetX =
			NormalX
			* MAGNET_STRENGTH

		TargetY =
			NormalY
			* MAGNET_STRENGTH

		if not Clicking then
			TargetRotation =
				OriginalRotation
				+ NormalX
				* TILT_STRENGTH

			TargetRotation -=
				NormalY
				* 0.65
		end
	else
		TargetX = 0
		TargetY = 0

		if not Clicking then
			TargetRotation =
				OriginalRotation
				+ IdleRotation
		end
	end

	local PositionAlpha =
		SmoothAlpha(
			MAGNET_SMOOTHNESS,
			DeltaTime
		)

	CurrentX +=
		(
			TargetX
			+ ClickOffsetX
			- CurrentX
		)
		* PositionAlpha

	CurrentY +=
		(
			TargetY
			+ ClickOffsetY
			+ IdleOffset
			- CurrentY
		)
		* PositionAlpha

	Button.Position =
		UDim2.new(
			OriginalPosition.X.Scale,

			OriginalPosition.X.Offset
			+ CurrentX,

			OriginalPosition.Y.Scale,

			OriginalPosition.Y.Offset
			+ CurrentY
		)

	local ScaleAlpha =
		SmoothAlpha(
			SCALE_SMOOTHNESS,
			DeltaTime
		)

	CurrentScale +=
		(
			TargetScale
			- CurrentScale
		)
		* ScaleAlpha

	Scale.Scale = CurrentScale

	local RotationAlpha =
		SmoothAlpha(
			TILT_SMOOTHNESS,
			DeltaTime
		)

	CurrentRotation +=
		(
			TargetRotation
			- CurrentRotation
		)
		* RotationAlpha

	Button.Rotation = CurrentRotation
end)

task.spawn(function()
	while Button.Parent and not Destroyed do
		task.wait(
			math.random(45, 75) / 10
		)

		if
			not Hovering
			and not Clicking
			and not Destroyed
		then
			PlaySound(IdleSound)

			IdleOffset = -1.5
			IdleRotation = -0.7
			TargetScale = 1.025

			task.wait(0.16)

			if
				not Hovering
				and not Clicking
				and not Destroyed
			then
				IdleOffset = 0.5
				IdleRotation = 0.55
				TargetScale = 0.992
			end

			task.wait(0.14)

			if
				not Hovering
				and not Clicking
				and not Destroyed
			then
				IdleOffset = -0.25
				IdleRotation = -0.2
				TargetScale = 1.008
			end

			task.wait(0.13)

			if
				not Hovering
				and not Clicking
				and not Destroyed
			then
				IdleOffset = 0
				IdleRotation = 0
				TargetScale = 1
			end
		end
	end
end)]]></ProtectedString>
